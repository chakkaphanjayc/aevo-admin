NODE_ENV=development
APP_VERSION=development
WEB_ORIGIN=http://localhost:4335
PORT=4335
AEVO_DEV_TUNNEL=0
# Optional stable public hostname used by the local launcher for auth/CORS.
# AEVO_ADMIN_TUNNEL_URL=https://admin-dev.example.com

# Canonical Aevo Core API. The Admin BFF proxies browser auth requests here.
AEVO_API_URL=http://localhost:4001
AEVO_APP_CODE=ADMIN
SESSION_COOKIE_NAME=aevo_admin_session
CSRF_COOKIE_NAME=aevo_admin_csrf

# Production examples:
# WEB_ORIGIN=https://admin.aevo.app
# AEVO_API_URL=https://api.aevo.app
